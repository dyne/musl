--- a/builds/cmake/ZeroMQConfig.cmake.in
+++ b/builds/cmake/ZeroMQConfig.cmake.in
@@ -16,6 +16,20 @@
 
 @PACKAGE_INIT@
 
+include(CMakeFindDependencyMacro)
+find_dependency(Threads)
+find_dependency(PkgConfig)
+set(_zmq_pkg_config_argn "${PKG_CONFIG_ARGN}")
+list(APPEND PKG_CONFIG_ARGN --static)
+if(@ZMQ_USE_GNUTLS@)
+  pkg_check_modules(ZMQ_GNUTLS REQUIRED IMPORTED_TARGET gnutls>=3.6.7)
+endif()
+if(@ZMQ_USE_LIBSODIUM@)
+  pkg_check_modules(ZMQ_SODIUM REQUIRED IMPORTED_TARGET libsodium)
+endif()
+set(PKG_CONFIG_ARGN "${_zmq_pkg_config_argn}")
+unset(_zmq_pkg_config_argn)
+
 if(NOT TARGET libzmq AND NOT TARGET libzmq-static)
